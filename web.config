<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <modules><remove name="WebDAVModule" /></modules>
    <!-- Backstop: refuse to serve secrets, DB dumps, spreadsheets, backups,
         or the internal backend/db/venv folders even though the FastAPI
         handler below owns "*". Request filtering runs before the handler
         is selected, so this holds even if the Python app ever regresses
         (it previously did: an earlier build mounted the whole project
         root as static files, which served backend/.env, backend/app/*.py
         and db/schema.sql to anyone, unauthenticated — fixed in main.py,
         this is the second, independent layer against the same class of
         mistake). Remove-then-add is required: IIS's own root-level
         web.config already declares some of these keys, and an <add>
         without a preceding <remove> for a key that already exists fails
         config resolution entirely (500.19) for every request. -->
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="true">
          <remove fileExtension=".env" />
          <add fileExtension=".env" allowed="false" />
          <remove fileExtension=".sql" />
          <add fileExtension=".sql" allowed="false" />
          <remove fileExtension=".bak" />
          <add fileExtension=".bak" allowed="false" />
          <remove fileExtension=".log" />
          <add fileExtension=".log" allowed="false" />
          <remove fileExtension=".xlsx" />
          <add fileExtension=".xlsx" allowed="false" />
        </fileExtensions>
        <hiddenSegments applyToWebDAV="true">
          <remove segment="backend" />
          <add segment="backend" />
          <remove segment="db" />
          <add segment="db" />
          <remove segment="__pycache__" />
          <add segment="__pycache__" />
          <remove segment=".git" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <handlers>
      <remove name="WebDAV" />
      <add name="PythonFastAPI" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <!-- ============================================================
         EDIT THESE PATHS to match this machine's install location before
         first run on a new clone/machine/drive. httpPlatformHandler
         requires processPath to be an absolute path, so it cannot be made
         relative. See description.md's "Production Deployment" section
         for the full first-run checklist.
           1. processPath      = the absolute path to this machine's python.exe
              (no dedicated/virtual environment — the app runs directly
              against the machine's normal Python install; see
              description.md for why and what that install must have)
           2. the app dir argument = the install root, then \backend
           3. stdoutLogFile    = the install root, then \backend\logs\uvicorn-stdout.log

         The trailing uvicorn flag disabling proxy headers is deliberate and
         must stay. Uvicorn turns that behaviour on by default and, because
         our peer is always 127.0.0.1, it would trust and rewrite
         request.client from the X-Forwarded-For header IIS sets. IIS writes
         that header in a non-standard "address:port" form describing its OWN
         peer, so the application ended up recording "[::1]:51203" as the
         user's IP address. With it off, request.client is the genuine TCP
         peer and every forwarded-header decision is made in one reviewed
         place: backend\app\client_ip.py.
         (An XML comment can't contain two hyphens in a row, which is why
         this can't just say the literal flag name here.)
         ============================================================ -->
    <httpPlatform processPath="C:\Program Files\Python311\python.exe"
                  arguments="-m uvicorn app.main:app --app-dir C:\inetpub\sites\Platforms\ASLG\backend --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --no-proxy-headers"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\inetpub\sites\Platforms\ASLG\backend\logs\uvicorn-stdout.log"
                  startupTimeLimit="120" startupRetryCount="3" requestTimeout="00:05:00" />
  </system.webServer>
</configuration>
