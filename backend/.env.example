DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aslg_legal
DB_USER=aslg_app
DB_PASSWORD=change-me

JWT_SECRET=generate-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Required only to run backend/seed.py (the CLI seeder or the Factory Reset
# endpoint) — seeding fails loudly instead of falling back to any default
# if the password it needs is unset. Not read anywhere else.
ASLG_SEED_ADMIN_PASSWORD=set-a-strong-password-before-seeding
ASLG_SEED_STAFF_PASSWORD=set-a-strong-password-before-seeding

# Shared secret for POST /api/internal/run-escalations (the Windows
# Scheduled Task hook that fixes the "no scheduler in this app" gap for
# Procedural Intelligence deadlines — see description.md's Production
# Deployment section and backend/app/routers/internal.py). There is no
# logged-in user driving that call, so it is gated on this header value
# instead of a JWT. Leave unset to disable the endpoint entirely (it then
# refuses every request rather than falling back to any default).
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ASLG_INTERNAL_TASK_TOKEN=generate-a-long-random-value

# UPLOAD_DIR and FRONTEND_DIR are resolved relative to the process's
# current working directory. That's "./uploads" and "../" (this file lives
# in backend/) ONLY for local dev, where the documented workflow is
# `cd backend && python -m uvicorn app.main:app`. Under IIS's
# httpPlatformHandler, the working directory is the folder containing
# web.config (the site root, not backend/) — so the PRODUCTION .env MUST
# use absolute paths for both instead, e.g.:
#   UPLOAD_DIR=C:\inetpub\sites\Platforms\ASLG\backend\uploads
#   FRONTEND_DIR=C:\inetpub\sites\Platforms\ASLG
# See description.md's Production Deployment section.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

SHARED_ASSETS_DIR=C:\inetpub\sites\_shared
FRONTEND_DIR=../

# Comma-separated. The frontend is always same-origin in a real deployment,
# so this rarely needs to change; only add an origin here if a genuinely
# separate site needs to call this API directly from browser JS.
CORS_ALLOWED_ORIGINS=http://app.alsaiflegalgroup.com,https://app.alsaiflegalgroup.com,http://127.0.0.1:8000,http://localhost:8000
